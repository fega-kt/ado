{
  "name": "ado-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "Static host + same-origin proxy cho ADO Project Dashboard, tránh CORS khi triển khai trên domain khác Azure DevOps Server.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore public/ server.js",
    "build": "node build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.5.0",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14"
  }
}
